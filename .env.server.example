# Node 批量插入後端（npm run server 會自動載入同目錄的 .env.server）
# 複製：copy .env.server.example .env.server
# 依終端「效能報告」建議再微調

# 請先跑 npm run tune-insert 找出你環境的最佳值，再複製到 .env.server
# 下列為 12 核 + 本機 Docker ES 一次調參結果（2026-06-02）
SERVER_CONCURRENCY=32
SERVER_BULK_SIZE=5000
SERVER_GENERATION_PARALLEL=12
SERVER_DOCS_PER_GEN_TASK=200
SERVER_PROGRESS_LOG_MS=2000

# 大量灌資料保持 false；需要立即可搜尋再改 true
# SERVER_BULK_REFRESH=false

# SERVER_PORT=3001

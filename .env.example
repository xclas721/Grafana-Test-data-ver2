# Node 批量插入後端（npm run server）— 複製 .env.server.example → .env.server
# 不進版控；調 SERVER_CONCURRENCY / SERVER_BULK_SIZE 等，完成後看終端效能報告

# 建置時會吃這些變數（Vite 只會注入 VITE_ 開頭的）
# 部署到 Vercel 時，在專案 Settings → Environment Variables 設定同名變數即可

# 後端 API 根網址（必填，正式環境）
VITE_API_BASE_URL=https://your-backend.zeabur.app

# 以下為選填，有預設值
# VITE_FRONTEND_CONTEXT_PATH=/
# VITE_FRONTEND_PORT=6600
# VITE_BACKEND_API_TIMEOUT=60000
# VITE_PAGE_SIZE=10
# VITE_SYSTEM_ID=InsightEdge-ES-TestData
# VITE_BACKEND_CONTEXT_PATH=

# DDoS 限流測試（acs-auth / acs-auth-web）
# 建置時寫入頂欄「API 網域」預設；留空則使用相對路徑 /acs-auth、/acs-auth-web
# VITE_ACS_AUTH_BASE=http://your-domain:30100
# VITE_ACS_AUTH_WEB_BASE=http://your-domain:8050
# 本機 dev 時 Vite 轉發目標（僅 vite.config.ts 使用）
# VITE_ACS_AUTH_PROXY=http://localhost:30100
# VITE_ACS_AUTH_WEB_PROXY=http://localhost:8050
#
# nginx 反向代理範例（部署可留空上述 BASE，由同源 proxy 轉發）：
#   location /acs-auth { proxy_pass http://backend:30100; }
#   location /acs-auth-web { proxy_pass http://acs-auth-web:8050; }

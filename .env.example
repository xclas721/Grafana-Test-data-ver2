# 建置時會吃這些變數（Vite 只會注入 VITE_ 開頭的）
# 部署到 Vercel 時，在專案 Settings → Environment Variables 設定同名變數即可

# 後端 API 根網址（必填，正式環境）
VITE_API_BASE_URL=https://your-backend.zeabur.app

# 以下為選填，有預設值
# VITE_FRONTEND_CONTEXT_PATH=/
# VITE_FRONTEND_PORT=6600
# VITE_BACKEND_API_TIMEOUT=60000
# VITE_PAGE_SIZE=10
# VITE_SYSTEM_ID=Brainwave
# VITE_BACKEND_CONTEXT_PATH=

# DDoS 限流測試（acs-auth / acs-auth-web，留空則 dev 使用 Vite proxy）
# VITE_ACS_AUTH_BASE=
# VITE_ACS_AUTH_WEB_BASE=
# VITE_ACS_AUTH_PROXY=http://localhost:30100
# VITE_ACS_AUTH_WEB_PROXY=http://localhost:8050
